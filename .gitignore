# User configuration (live data — the app rewrites it constantly; never track it)
soundboard_config.json
# Config safety backups. A *tracked* .bak is how the people-data wipe destroyed
# the only good copy — keep every backup out of git.
*.bak
soundboard_config.json.bak

# Sound files (user content)
sounds/

# Image files (user content)
images/

# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environments
venv/
.venv/
env/
.env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Distribution / packaging (PyInstaller output + staging/rollback copies)
dist/
build/
*.egg-info/
dist_fresh/
build_fresh/
dist_new/
build_new/
dist_old/

# Local config safety backups + recovery scratch (not source)
config_backups/
_recovery/

# Decoded-PCM audio cache (rebuilt automatically from sounds/)
audio_cache/

# Runtime logs / profiling artifacts (not source)
debug.log
debug.log.*
perf.log
importtime.txt

# Mobile companion sync (soundboard/mobile_sync.py) — md5 cache, rebuildable
mobile_sync_hashcache.json
# Android project build output (mobile/android/, created in Phase 1)
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/local.properties
*.keystore
